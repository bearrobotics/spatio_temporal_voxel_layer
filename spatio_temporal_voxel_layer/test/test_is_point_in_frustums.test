<launch>
    <test test-name="test_is_point_in_frustums" pkg="spatio_temporal_voxel_layer"
        type="test_is_point_in_frustums"
        bazel="ROS/external/navigation/spatio_temporal_voxel_layer/test_is_point_in_frustums_runner">
        <rosparam command="load" ns="/is_point_test">
            frustum:
                type: 3d_camera
                vertical_fov_angle: 1.0
                horizontal_fov_angle: 1.2
                min_z: 0.1
                max_z: 5.0
        </rosparam>
    </test>
</launch>
