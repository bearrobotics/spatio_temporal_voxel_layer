<launch>
    <test test-name="test_blind_spot_integration" pkg="spatio_temporal_voxel_layer"
        type="test_blind_spot_integration"
        bazel="ROS/external/navigation/spatio_temporal_voxel_layer/test_blind_spot_integration_runner">
        <rosparam command="load" ns="/blind_spot_integration_test">
            frustum:
                type: 3d_camera
                vertical_fov_angle: 1.0
                horizontal_fov_angle: 1.2
                min_z: 0.1
                max_z: 5.0
        </rosparam>
    </test>
</launch>
