<launch>
    <test test-name="test_decay_pass" pkg="spatio_temporal_voxel_layer"
        type="test_decay_pass"
        bazel="ROS/external/navigation/spatio_temporal_voxel_layer/test_decay_pass_runner">
        <rosparam command="load" ns="/decay_pass_test">
            frustum:
                type: 3d_camera
                vertical_fov_angle: 1.0
                horizontal_fov_angle: 1.2
                min_z: 0.1
                max_z: 5.0
        </rosparam>
    </test>
</launch>
